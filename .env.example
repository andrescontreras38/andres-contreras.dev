# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-o-publishable-key

# Dominio del despliegue. De aquí salen las URLs canónicas, el sitemap y el
# structured data, y Vite lo resuelve al compilar: si cambia, hay que volver a
# desplegar. En Vercel, ponlo con la URL real (temporal o definitiva).
VITE_SITE_URL=https://contreras.dev

# El sitio se publica con noindex mientras esto no valga exactamente "true".
# Actívalo solo cuando esté en el dominio definitivo: si se indexa la URL
# provisional, después compite con la buena.
VITE_ALLOW_INDEXING=false
